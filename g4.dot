graph {
    splines=line;
    node [image="image.png" shape="none"];
    node [fixedsize=true, width=1.2, height=1, imagescale=true, labelloc=b, fontcolor=red];
    edge [fontsize=20, fontcolor=blue]
    

    A [pos="10,5!"];
    B [pos="7,8!"];
    C [pos="7,4!"];
    D [pos="4,4!"];
    E [pos="5,1!"];
    F [pos="1,2!"];
    G [pos="2,6!"];
    H [pos="4,8!"];

    B -- A [label = "1"];
    B -- C [label = "2"];
    B -- G [label = "4"];
    B -- H [label = "2"];
    C -- A [label = "4"];
    H -- G [label = "14"];
    B -- D [label = "9"];
    F -- E [label = "1"];
    C -- E [label = "3"];
    E -- D [label = "1"];
    F -- D [label = "3"];
    F -- G [label = "6"];
}